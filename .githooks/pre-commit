#!/usr/bin/env node
/* ── .githooks/pre-commit — keep CHANGELOG.md in sync automatically ──
 * Regenerates CHANGELOG.md from js/site-updates.js (SITE_UPDATES.items) and
 * stages it, so the changelog can never drift from what members see in the
 * in-app What's-new history overlay.
 *
 * Enabled once per clone with `npm run hooks:install` (that also runs from
 * `npm install` via the "prepare" script, so it is automatic for everyone).
 *
 * Privacy failures block the commit. Validate staged and working-tree release
 * notes, regenerate the changelog, then stage the validated output.
 * CI repeats validation; it is not a substitute for pre-push review. */
'use strict';
const { execFileSync } = require('child_process');
const { assertPublicNotes } = require('../tools/changelog-privacy');

try {
  for (const file of ['js/site-updates.js', 'CHANGELOG.md']) {
    assertPublicNotes(execFileSync('git', ['show', ':' + file], {
      encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'],
    }));
  }
  execFileSync(process.execPath, ['tools/build-changelog.js'], {
    cwd: process.cwd(),
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  execFileSync('git', ['add', 'CHANGELOG.md'], { stdio: 'ignore' });
  console.log('[pre-commit] CHANGELOG.md regenerated + staged (auto-update)');
} catch (e) {
  console.error('[pre-commit] Release-note validation or generation failed. Review locally; content is not logged.');
  process.exit(1);
}
process.exit(0);