{
  "name": "yaadadz-page-generator",
  "version": "1.0.0",
  "description": "Static ad page generator for Yaad Adz",
  "private": true,
  "scripts": {
    "prepare": "node tools/install-hooks.js",
    "hooks:install": "node tools/install-hooks.js",
    "generate": "node generate-pages.js",
    "gas:scrape": "node scrape-petrojam-archive.js",
    "gas:scrape:db": "node scrape-petrojam-archive.js --db",
    "stations:snapshot": "node scrape-gas-stations.js",
    "notify:update": "node notify-site-update.js",
    "changelog": "node tools/build-changelog.js",
    "changelog:check": "node tools/build-changelog.js && git diff --exit-code -- CHANGELOG.md",
    "verify": "node tools/verify-v2.js",
    "test": "node tools/test-cleanup.js && node tools/verify-v2.js && node tools/test-page-scripts.js && node tools/test-chat-v2.js && node tools/test-chat-wiring.js && node tools/test-onboarding.js && node tools/test-data-safety.js && node tools/test-p1-parity.js && node tools/test-p1-no-cdn.js && node tools/test-admin.js && node tools/test-reports.js && node tools/test-for-you.js && node --test tools/test-account-referrals.js",
    "test:onboarding": "node tools/test-onboarding.js",
    "test:cleanup": "node tools/test-cleanup.js",
    "test:safety": "node tools/test-data-safety.js",
    "test:chat": "node tools/test-chat-v2.js",
    "test:chat-wiring": "node tools/test-chat-wiring.js",
    "test:msg-v2": "node tools/test-msg-v2.js",
    "test:photo": "node tools/test-photo-gestures.js",
    "test:hero": "node tools/test-hero-layout.js",
    "test:for-you": "node tools/test-for-you.js",
    "fy:preview": "node tools/fy-preview.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "supabase": "^2.109.1"
  }
}
